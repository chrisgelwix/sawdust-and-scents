# Nx build cache — MUST be excluded or Nx will use cached compiled output
# inside the Docker build instead of recompiling from source. This caused
# code changes to database.module.ts to be silently ignored across multiple
# Docker builds.
.nx

# Local build output — the Dockerfile builds fresh inside the container
dist

# Local node_modules — installed fresh by npm ci inside the container
node_modules

# Git metadata
.git
.gitignore

# IDE / editor files
.cursor
.vscode
*.code-workspace

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Test output
coverage
