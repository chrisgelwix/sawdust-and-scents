  "scripts": {
    "prepare": "husky install",
    "dev": "cross-env NX_ISOLATE_PLUGINS=false nx run-many --target=serve --projects=api,web --parallel",
    "build": "cross-env NX_ISOLATE_PLUGINS=false nx run-many --target=build --projects=api,web",
    "test": "cross-env NX_ISOLATE_PLUGINS=false nx run-many --target=test --all",
    "lint": "cross-env NX_ISOLATE_PLUGINS=false nx run-many --target=lint --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "api:dev": "cross-env NX_ISOLATE_PLUGINS=false nx serve api",
    "api:build": "cross-env NX_ISOLATE_PLUGINS=false nx build api",
    "api:test": "cross-env NX_ISOLATE_PLUGINS=false nx test api",
    "web:dev": "cross-env NX_ISOLATE_PLUGINS=false nx serve web",
    "web:build": "cross-env NX_ISOLATE_PLUGINS=false nx build web",
    "web:test": "cross-env NX_ISOLATE_PLUGINS=false nx test web",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d apps/api/typeorm.config.ts",
    "migration:run": "npm run typeorm -- migration:run -d apps/api/typeorm.config.ts",
    "test:api": "npx playwright test --config=apps/e2e/playwright.config.ts --project=api"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
